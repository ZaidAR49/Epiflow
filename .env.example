# ==============================================================================
# EpiFlow Platform Environment Variables (Example)
# All sensitive credentials must be set in your secure environment or .env.local
# DO NOT commit real secrets to source control.
# ==============================================================================

# Platform & Branding Configuration
NEXT_PUBLIC_APP_NAME=EpiFlow
NEXT_PUBLIC_PLATFORM_NAME=epiflow

# Database (PostgreSQL / Supabase connection pooling)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Apify (LinkedIn Scraping Actors)
APIFY_TOKEN=apify_api_token_here

# AI Providers (Gemini primary, Anthropic Claude fallback)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_SECRET_TOKEN=a_secure_random_hex_string_for_webhook_verification

# Token Encryption (AES-256-GCM 32-byte hex key for encrypting refresh tokens at rest)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth & Gmail API (restricted to gmail.compose and drive scopes)
# Authorized redirect URIs to register in Google Cloud Console:
#   1. Platform Sign-in (NextAuth):
#      http://localhost:3000/api/auth/callback/google
#      https://your-domain.com/api/auth/callback/google
#   2. Workflow Gmail Connect (use platform name slug, not job-xray):
#      http://localhost:3000/api/workflows/epiflow/auth/google/callback
#      https://your-domain.com/api/workflows/epiflow/auth/google/callback
# Set to the exact URI registered above (local or production):
GOOGLE_WORKFLOW_REDIRECT_URI=http://localhost:3000/api/workflows/epiflow/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
AUTH_SECRET=your_authjs_secret_hex_string_32_bytes
AUTH_URL=http://localhost:3000

# Supabase Storage & Cloud (used for workflow picture uploads and public assets)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Contact Form & Email Delivery (Resend API)
# 1. Sign up for free at https://resend.com (includes 3,000 free emails/month)
# 2. Generate an API Key and paste it below
RESEND_API_KEY=re_your_resend_api_key_here

# The recipient email address where user messages from the Contact Us form will be sent to you:
CONTACT_TO_EMAIL=your_email@example.com

# Verified sender address or domain in Resend (default: onboarding@resend.dev for testing):
CONTACT_FROM_EMAIL=EpiFlow Contact <onboarding@resend.dev>

# Lemon Squeezy (Merchant of Record / Payments)
# 1. Sign up at https://app.lemonsqueezy.com/register (Test Mode available instantly without business registration)
# 2. In Settings > API Keys, generate a key:
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
# 3. In Settings > Stores, find your Store ID (numeric):
LEMONSQUEEZY_STORE_ID=123456
# 4. In Settings > Webhooks, add endpoint: https://yourdomain.com/api/billing/webhook
#    Select events: Subscription created/updated/cancelled/resumed/expired, Order created
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_signing_secret
