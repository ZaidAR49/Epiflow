# ==============================================================================
# JobPost X-Ray Environment Variables (Example)
# All sensitive credentials must be set in your secure environment or .env.local
# DO NOT commit real secrets to source control.
# ==============================================================================

# Database (PostgreSQL / Supabase connection pooling)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Apify (LinkedIn Scraping Actors)
APIFY_TOKEN=apify_api_token_here

# AI Providers (Gemini primary, Anthropic Claude fallback)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_SECRET_TOKEN=a_secure_random_hex_string_for_webhook_verification

# Google OAuth & Gmail API (restricted to gmail.compose and drive scopes)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
AUTH_SECRET=your_authjs_secret_hex_string_32_bytes

# Token Encryption (AES-256-GCM 32-byte hex key for encrypting refresh tokens at rest)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Storage & Cloud (used for workflow picture uploads and public assets)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

